# Copy to .env locally. Never commit .env or share these values in chat.
PORT=8080
# Docker Compose will override DATABASE_URL with the private database host.
DATABASE_URL=postgresql://neurocare:CHANGE_ME@db:5432/neurocare
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
PGSSL=false
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CLINIC_CODE=SAFFARI
DOCTOR_LOGIN=SAFFARI
DOCTOR_DISPLAY_NAME=دکتر صفاری
# Generate with: node -e "require('bcryptjs').hash('a-new-strong-password',12).then(console.log)"
DOCTOR_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
# Exact frontend origins, comma-separated, including protocol. Example:
# CORS_ORIGINS=https://neurocare.mhsaffari.ir
CORS_ORIGINS=
